#!/usr/bin/env bash
# ==============================================================================
# WAYCLICK ELITE - ARCH LINUX / UV OPTIMIZED (ThinkPad Edition) | FAST & SAFE
# ==============================================================================

set -euo pipefail
trap cleanup EXIT INT TERM

# --- CONFIGURATION ---
readonly APP_NAME="wayclick"
readonly CONFIG_ENABLE_TRACKPADS="false"  # Set to "true" to include Synaptics/Trackpoint
readonly BASE_DIR="$HOME/contained_apps/uv/$APP_NAME"
readonly VENV_DIR="$BASE_DIR/.venv"
readonly RUNNER_SCRIPT="$BASE_DIR/runner.py"
readonly CONFIG_DIR="$HOME/.config/wayclick"

# --- ANSI COLORS ---
readonly C_RED=$'\033[1;31m'
readonly C_GREEN=$'\033[1;32m'
readonly C_BLUE=$'\033[1;34m'
readonly C_CYAN=$'\033[1;36m'
readonly C_YELLOW=$'\033[1;33m'
readonly C_DIM=$'\033[2m'
readonly C_RESET=$'\033[0m'

cleanup() {
    tput cnorm 2>/dev/null || true
}

# --- ROOT CHECK ---
if [[ $EUID -eq 0 ]]; then
    printf "%b[CRITICAL]%b Do not run this script as root.\n" "${C_RED}" "${C_RESET}"
    exit 1
fi

# --- TOGGLE LOGIC ---
if pgrep -f "$VENV_DIR/bin/python.*$RUNNER_SCRIPT" >/dev/null; then
    printf "%b[TOGGLE]%b Stopping active instance...\n" "${C_YELLOW}" "${C_RESET}"
    command -v notify-send >/dev/null && notify-send --app-name="WayClick" "WayClick Elite" "Disabled 🔕"
    pkill -f "$VENV_DIR/bin/python.*$RUNNER_SCRIPT"
    while pgrep -f "$VENV_DIR/bin/python.*$RUNNER_SCRIPT" >/dev/null; do sleep 0.1; done
    exit 0
fi

# --- INTERACTIVE DETECTION ---
if [[ -t 0 ]]; then INTERACTIVE=true; else INTERACTIVE=false; fi

notify_user() {
    command -v notify-send >/dev/null && notify-send --app-name="WayClick" "WayClick Elite" "$1"
}

# --- DEPENDENCY CHECK ---
NEEDED_DEPS=""
command -v uv >/dev/null || NEEDED_DEPS="$NEEDED_DEPS uv"
command -v notify-send >/dev/null || NEEDED_DEPS="$NEEDED_DEPS libnotify"

if [[ -n "$NEEDED_DEPS" ]]; then
    if $INTERACTIVE; then
        printf "%b[SETUP]%b Missing dependencies:%b%s%b\n" "${C_YELLOW}" "${C_RESET}" "${C_CYAN}" "$NEEDED_DEPS" "${C_RESET}"
        sudo pacman -S --needed $NEEDED_DEPS && printf "%b[SUCCESS]%b Dependencies installed.\n" "${C_GREEN}" "${C_RESET}" || exit 1
    else
        notify_user "Missing dependencies. Run in terminal first."
        exit 1
    fi
fi

# --- GROUP CHECK ---
if ! groups "$USER" | grep -q "\binput\b"; then
    if $INTERACTIVE; then
        printf "%b[PERM]%b User '%s' is not in 'input' group.\n" "${C_RED}" "${C_RESET}" "$USER"
        read -p "Run 'sudo usermod -aG input $USER'? [Y/n] " -n 1 -r; echo
        [[ $REPLY =~ ^[Yy]$ ]] && sudo usermod -aG input "$USER" && printf "%b[INFO]%b Group added. LOGOUT REQUIRED.\n" "${C_GREEN}" "${C_RESET}" && exit 0
        exit 1
    else
        notify_user "Permission error: User not in 'input' group."
        exit 1
    fi
fi

# --- CONFIG FILE CHECK ---
[[ -f "${CONFIG_DIR}/config.json" ]] || { notify_user "Missing config.json in ~/.config/wayclick"; exit 1; }

# --- ENVIRONMENT SETUP ---
mkdir -p "$BASE_DIR"

[[ -d "$VENV_DIR" ]] || { printf "%b[BUILD]%b Initializing UV environment...\n" "${C_BLUE}" "${C_RESET}"; uv venv "$VENV_DIR" --python 3.13 --quiet; }

MARKER_FILE="$BASE_DIR/.build_marker_v4"
if [[ ! -f "$MARKER_FILE" ]]; then
    printf "%b[BUILD]%b Installing dependencies...\n" "${C_YELLOW}" "${C_RESET}"
    uv pip install --python "$VENV_DIR/bin/python" --compile-bytecode evdev pygame-ce
    touch "$MARKER_FILE"
fi

# --- PYTHON RUNNER ---
cat > "$RUNNER_SCRIPT" << 'EOF'
import asyncio, os, sys, signal, random, json
os.environ['PYGAME_HIDE_SUPPORT_PROMPT']='1'
os.environ['SDL_BUFFER_CHUNK_SIZE']='1024'
import pygame, evdev
from evdev import ecodes

ASSET_DIR = sys.argv[1]
ENABLE_TRACKPADS = os.environ.get('ENABLE_TRACKPADS','false').lower()=='true'

# --- INIT SOUND ---
try:
    pygame.mixer.pre_init(frequency=44100,size=-16,channels=2,buffer=512)
    pygame.mixer.init()
    pygame.mixer.set_num_channels(32)
except pygame.error:
    sys.exit(1)

CONFIG_FILE = os.path.join(ASSET_DIR,"config.json")
try:
    with open(CONFIG_FILE,'r') as f:
        config_data=json.load(f)
        RAW_KEY_MAP={int(k):v for k,v in config_data.get("mappings",{}).items()}
        DEFAULTS=config_data.get("defaults",[])
except:
    sys.exit(1)

SOUND_FILES=list(set(list(RAW_KEY_MAP.values())+DEFAULTS))
SOUNDS={}

for filename in SOUND_FILES:
    path=os.path.join(ASSET_DIR,filename)
    if os.path.exists(path):
        try: SOUNDS[filename]=pygame.mixer.Sound(path)
        except pygame.error: pass

MAX_KEYCODE=1024  # faster + memory efficient
SOUND_CACHE=[None]*MAX_KEYCODE
DEFAULT_SOUND_OBJS=[SOUNDS[f] for f in DEFAULTS if f in SOUNDS]

for code,filename in RAW_KEY_MAP.items():
    if code<MAX_KEYCODE and filename in SOUNDS:
        SOUND_CACHE[code]=SOUNDS[filename]

_random_choice=random.choice

def play_sound(code):
    if code<MAX_KEYCODE:
        sound=SOUND_CACHE[code]
        if sound:
            sound.play()
            return
    if DEFAULT_SOUND_OBJS:
        _random_choice(DEFAULT_SOUND_OBJS).play()

REJECTED_DEVICES=set()  # cache rejected devices for speed

async def read_device(path, stop_event):
    dev=None
    try:
        dev=evdev.InputDevice(path)
        async for event in dev.async_read_loop():
            if stop_event.is_set(): break
            if event.type==1 and event.value==1: play_sound(event.code)
    except Exception: pass
    finally:
        if dev: dev.close()

async def main():
    stop=asyncio.Event()
    loop=asyncio.get_running_loop()
    for sig in (signal.SIGINT,signal.SIGTERM): loop.add_signal_handler(sig, stop.set)
    monitored_tasks={}

    while not stop.is_set():
        try:
            all_paths=evdev.list_devices()
            for path in all_paths:
                if path in monitored_tasks or path in REJECTED_DEVICES: continue
                try:
                    dev=evdev.InputDevice(path)
                    if not ENABLE_TRACKPADS:
                        name_lower=dev.name.lower()
                        if any(x in name_lower for x in ['touchpad','trackpad','synaptics','trackpoint','ibm']):
                            dev.close()
                            REJECTED_DEVICES.add(path)
                            continue
                    caps=dev.capabilities()
                    if 1 in caps:
                        task=asyncio.create_task(read_device(path,stop))
                        monitored_tasks[path]=task
                    dev.close()
                except Exception: REJECTED_DEVICES.add(path); continue
        except Exception: pass

        dead_paths=[p for p,t in monitored_tasks.items() if t.done()]
        for p in dead_paths: del monitored_tasks[p]

        try:
            await asyncio.wait_for(stop.wait(), timeout=5.0)
        except asyncio.TimeoutError: continue

    for t in monitored_tasks.values(): t.cancel()
    pygame.mixer.quit()

if __name__=="__main__":
    try: asyncio.run(main())
    except KeyboardInterrupt: pass
EOF

# --- EXECUTION ---
printf "%b[RUN]%b Starting engine...\n" "${C_BLUE}" "${C_RESET}"
if ! $INTERACTIVE; then notify_user "Enabled 🔔"; fi
ENABLE_TRACKPADS="$CONFIG_ENABLE_TRACKPADS" "$VENV_DIR/bin/python" -O "$RUNNER_SCRIPT" "$CONFIG_DIR"

